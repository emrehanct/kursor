    <string name="pc_help_title">Keyboard shortcuts</string>
    <string name="pc_help">Ctrl+L or F6 — address / search\nF5 or Ctrl+R — reload\nAlt+← / Alt+→ — back / forward\nAlt+Home — home page\nCtrl + / Ctrl − / Ctrl 0 — text size\nEsc — close menu / exit full screen\nMenu key — ad blocking\n\nMouse: click, wheel to scroll. The remote\'s arrow keys bring the on-screen cursor back.</string>
